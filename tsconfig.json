{
	"compilerOptions": {
		"target": "ESNext",
		"esModuleInterop": true,
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"declaration": true,
		"allowSyntheticDefaultImports": true,
		"module": "NodeNext",
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules"
	]
}