{
	"name": "kirakira-rosales",
	"version": "1.0.0",
	"description": "KIRAKIRA-Rosales, The RESTful Back-end API created with Fastify.",
	"main": "src/app.fastify.ts",
	"type": "module",
	"author": "KIRAKIRA Project Team",
	"private": true,
	"scripts": {
		"start": "tsx src/app.fastify.ts",
