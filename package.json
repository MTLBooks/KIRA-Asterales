{
	"name": "kirakira-rosales",
	"version": "1.0.0",
	"description": "KIRAKIRA-Rosales, The RESTful Back-end API Created by koa.",
	"main": "src/app.ts",
	"type": "module",
	"author": "KIRAKIRA Project Team",
	"private": true,
	"scripts": {
		"start": "tsc --noEmitOnError --sourceMap --outDir .kirakira && npm run copy-assets-dev && node ./.kirakira/app.js",
		"dev": "npm start",
		"serve": "npm start",
		"dev-hot": "nodemon --watch \"src\" --ext ts --delay 1500ms --exec \"npm start\"",
		"build": "tsc --removeComments --declaration && npm run copy-assets-build",
		"copy-assets-dev": "copyfiles -u 1 src/assets/**/* .kirakira/",
		"copy-assets-build": "copyfiles -u 1 src/assets/**/* dist/"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/koa": "^2.13.5",
		"@types/koa-route": "^3.2.5",
		"@types/koa-router": "^7.4.4",
		"@types/node": "^20.19.10",
		"@types/safe-regex": "^1.1.6",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"copyfiles": "^2.4.1",
		"esbuild-register": "^3.4.1",
		"eslint": "^9.9.0",
		"nodemon": "^3.1.4",
		"typescript": "^5.5.4"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.456.0",
		"@aws-sdk/client-secrets-manager": "^3.758.0",
		"@aws-sdk/s3-request-presigner": "^3.456.0",
		"@elastic/elasticsearch": "^8.11.0",
		"@koa/cors": "^5.0.0",
		"@types/bcrypt": "^5.0.2",
		"@types/koa-bodyparser": "^4.3.10",
		"axios": "^1.4.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^16.4.5",
		"emailjs": "^4.0.3",
		"js-base64": "^3.7.5",
		"koa": "^2.14.1",
		"koa-bodyparser": "^4.4.0",
		"koa-router": "^12.0.0",
		"mongodb": "^6.18.0",
		"mongoose": "^8.5.2",
		"otplib": "^12.0.1",
		"safe-regex": "^2.1.1",
		"uuid": "^11.0.5"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
